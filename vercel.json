{
  "headers": [
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/OneSignalSDKWorker.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/cron-montag", "schedule": "30 8 * * 1" },
    { "path": "/api/cron-samstag", "schedule": "0 9 * * 6" },
    { "path": "/api/cron-loyalty-reminders", "schedule": "0 11 * * *" }
  ]
}
